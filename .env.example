APP_ENV=local
APP_PASSWORD=
APP_URL=https://kit-subscriber-auditor.test

# Optional fallback. Prefer connecting with OAuth from Settings.
KIT_API_KEY=

# Create a Kit OAuth app, enable PKCE, and register this exact redirect URI.
KIT_OAUTH_CLIENT_ID=
KIT_OAUTH_REDIRECT_URI=https://kit-subscriber-auditor.test/oauth/callback
